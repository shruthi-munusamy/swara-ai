# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/

# Envs
venv/
.venv/
env/

# IDE / OS
.vscode/
.idea/
.DS_Store

# Local-only
.local/

# Project
data/raw/
data/processed/*
# Reproducibility artifacts: small, hand-inspectable, define the MVP raga
# set and splits -- unlike cached .npz features, these are meant to be
# committed so training is reproducible from a fresh clone. (Negation only
# works against the non-slash "data/processed/*" form -- a trailing-slash
# directory exclusion stops git from descending in at all.)
!data/processed/mvp_ragas.yaml
!data/processed/splits.yaml
models/*.pt
models/*.ckpt
wandb/
*.log
.ipynb_checkpoints/
# TensorFlow / Keras runtime artifacts
*.pb
saved_model.pb
checkpoints/
tf_logs/
.keras/

# Audio (large)
*.wav
*.mp3
*.flac
!data/samples/*.wav

# Frontend
frontend/node_modules/
frontend/dist/